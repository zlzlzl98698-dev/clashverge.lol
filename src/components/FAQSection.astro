---
export interface FAQItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  items: FAQItem[];
}

const {
  title = '常见问题解答 (FAQ)',
  subtitle = '基于真实用户搜索问题与实测反馈整理，帮助你快速定位答案',
  items = [],
} = Astro.props;
---

{
  items.length > 0 && (
    <section class="my-10" aria-labelledby="faq-section-heading">
      <div class="mb-5">
        <h2 id="faq-section-heading" class="text-xl sm:text-2xl font-bold text-[#172033]">
          {title}
        </h2>
        {subtitle && <p class="text-sm text-[#64748B] mt-1">{subtitle}</p>}
      </div>

      <div class="space-y-3">
        {items.map((item, index) => (
          <details
            class="group card-surface p-4 sm:p-5 open:border-[#2563EB]/40 open:bg-[#F7F9FC]/50 transition-colors"
            open={index === 0}
          >
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-semibold text-[#172033] text-base">
              <span class="flex items-start gap-2.5">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#EFF6FF] text-[#2563EB] text-xs font-bold shrink-0 mt-0.5">
                  Q
                </span>
                <span>{item.q}</span>
              </span>
              <svg
                class="w-5 h-5 text-[#64748B] shrink-0 mt-0.5 group-open:rotate-180 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="mt-3 pt-3 border-t border-[#E5EAF1] pl-8 text-sm sm:text-[15.5px] text-[#172033]/85 leading-relaxed">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}
