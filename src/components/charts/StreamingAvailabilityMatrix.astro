---
import type { AirportBrand, UnlockStatus } from '../../data/brands';

export interface Props {
  brand: AirportBrand;
}

const { brand } = Astro.props;

interface ServiceItem {
  key: string;
  name: string;
  category: 'AI 生产力平台' | '海外流媒体服务';
  status: UnlockStatus;
}

const services: ServiceItem[] = [
  { key: 'chatgpt', name: 'ChatGPT (OpenAI)', category: 'AI 生产力平台', status: brand.unlockMatrix.chatgpt },
  { key: 'claude', name: 'Claude (Anthropic)', category: 'AI 生产力平台', status: brand.unlockMatrix.claude },
  { key: 'gemini', name: 'Google Gemini', category: 'AI 生产力平台', status: brand.unlockMatrix.gemini },
  { key: 'netflix', name: 'Netflix (自制/非自制)', category: '海外流媒体服务', status: brand.unlockMatrix.netflix },
  { key: 'disneyPlus', name: 'Disney+', category: '海外流媒体服务', status: brand.unlockMatrix.disneyPlus },
  { key: 'youtube', name: 'YouTube 4K / Premium', category: '海外流媒体服务', status: brand.unlockMatrix.youtube },
  { key: 'hboMax', name: 'HBO Max', category: '海外流媒体服务', status: brand.unlockMatrix.hboMax },
  { key: 'tiktok', name: 'TikTok (跨区访问)', category: '海外流媒体服务', status: brand.unlockMatrix.tiktok },
  { key: 'spotify', name: 'Spotify', category: '海外流媒体服务', status: brand.unlockMatrix.spotify },
];

function getStatusMeta(status: UnlockStatus) {
  switch (status) {
    case 'Supported':
      return {
        code: 'OPERATIONAL',
        label: '实测支持解锁',
        dotColor: 'bg-emerald-400',
        badgeClass: 'bg-emerald-950/80 text-emerald-300 border-emerald-700/60',
      };
    case 'Partial':
      return {
        code: 'PARTIAL',
        label: '视节点而定',
        dotColor: 'bg-amber-400',
        badgeClass: 'bg-amber-950/80 text-amber-300 border-amber-700/60',
      };
    case 'VendorClaim':
      return {
        code: 'VENDOR DATA',
        label: '品牌资料宣称',
        dotColor: 'bg-sky-400',
        badgeClass: 'bg-sky-950/80 text-sky-300 border-sky-700/60',
      };
    case 'Unsupported':
      return {
        code: 'UNAVAILABLE',
        label: '实测多失败',
        dotColor: 'bg-rose-400',
        badgeClass: 'bg-rose-950/80 text-rose-300 border-rose-700/60',
      };
    default:
      return {
        code: 'NOT TESTED',
        label: '尚未统一实测',
        dotColor: 'bg-slate-400',
        badgeClass: 'bg-slate-800 text-slate-300 border-slate-700',
      };
  }
}
---

<section
  class="observatory-panel p-5 sm:p-6 my-8"
  aria-label={`${brand.name} AI 与流媒体解锁状态矩阵`}
>
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-800">
    <div>
      <h3 class="text-base sm:text-lg font-bold text-slate-100">
        {brand.name} · Streaming & AI Service Availability Matrix
      </h3>
      <p class="text-xs font-mono text-slate-400 mt-0.5">
        状态分类：OPERATIONAL(实测支持) / PARTIAL(视节点而定) / VENDOR DATA(品牌资料) / NOT TESTED(待核实)
      </p>
    </div>
    <span class="px-2.5 py-1 rounded text-[11px] font-mono bg-slate-800 text-slate-300 border border-slate-700">
      VERIFIED: {brand.verifiedDate}
    </span>
  </div>

  <!-- 3-Column Responsive Grid -->
  <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    {services.map((srv) => {
      const meta = getStatusMeta(srv.status);
      return (
        <div class="p-3.5 rounded-xl bg-[#111827] border border-slate-800/90 flex items-center justify-between gap-3">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 block">
              {srv.category}
            </span>
            <strong class="text-sm text-slate-100 font-semibold">{srv.name}</strong>
          </div>
          <div class="text-right shrink-0">
            <span
              class:list={[
                'inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-mono border',
                meta.badgeClass,
              ]}
            >
              <span class:list={['w-1.5 h-1.5 rounded-full', meta.dotColor]} />
              {meta.code}
            </span>
            <span class="block text-[11px] text-slate-400 mt-1">{meta.label}</span>
          </div>
        </div>
      );
    })}
  </div>

  <div class="mt-4 pt-3 border-t border-slate-800 text-xs text-slate-300 leading-relaxed flex flex-col sm:flex-row sm:items-center justify-between gap-2">
    <div>
      <strong>解锁说明：</strong>
      {brand.unlockMatrix.notes}
    </div>
    <span class="font-mono text-[11px] text-slate-400 shrink-0">[RegionRestrictionCheck Matrix]</span>
  </div>
</section>
