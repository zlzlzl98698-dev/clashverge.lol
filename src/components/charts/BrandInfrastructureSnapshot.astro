---
import type { AirportBrand } from '../../data/brands';

export interface Props {
  brand: AirportBrand;
}

const { brand } = Astro.props;
---

<section
  class="observatory-panel p-5 sm:p-6 my-8"
  aria-label={`${brand.name} 基础设施与技术规格快照`}
>
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-800">
    <div class="flex items-center gap-3">
      <span
        class="w-3 h-8 rounded-full"
        style={`background-color: ${brand.accentColor || '#2563EB'};`}
      />
      <div>
        <h3 class="text-base sm:text-lg font-bold text-slate-100">
          {brand.name} ({brand.englishName}) · Infrastructure Service Snapshot
        </h3>
        <p class="text-xs font-mono text-slate-400">
          SLUG: {brand.slug} | FOUNDED: {brand.foundedYear} | VERIFIED: {brand.verifiedDate}
        </p>
      </div>
    </div>
    <span class="px-2.5 py-1 rounded text-xs font-mono bg-slate-800 text-slate-200 border border-slate-700">
      COUPON: {brand.couponCode}
    </span>
  </div>

  <div class="mt-5 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
    <div class="p-3 rounded-xl bg-[#111827] border border-slate-800">
      <span class="text-[11px] font-mono text-slate-400 block">LINE ARCHITECTURE</span>
      <strong class="text-sm text-slate-100 mt-1 block">{brand.lineType}</strong>
    </div>
    <div class="p-3 rounded-xl bg-[#111827] border border-slate-800">
      <span class="text-[11px] font-mono text-slate-400 block">PROTOCOLS</span>
      <strong class="text-sm text-emerald-400 font-mono mt-1 block">{brand.protocols.join(' / ')}</strong>
    </div>
    <div class="p-3 rounded-xl bg-[#111827] border border-slate-800">
      <span class="text-[11px] font-mono text-slate-400 block">CLIENT MODE</span>
      <strong class="text-sm text-sky-300 mt-1 block">{brand.clientSupport}</strong>
    </div>
    <div class="p-3 rounded-xl bg-[#111827] border border-slate-800">
      <span class="text-[11px] font-mono text-slate-400 block">DEVICE POLICY</span>
      <strong class="text-sm text-slate-100 mt-1 block">{brand.deviceLimit}</strong>
    </div>
    <div class="p-3 rounded-xl bg-[#111827] border border-slate-800">
      <span class="text-[11px] font-mono text-slate-400 block">MULTIPLIER</span>
      <strong class="text-sm text-slate-100 mt-1 block">{brand.rateMultiplier}</strong>
    </div>
    <div class="p-3 rounded-xl bg-[#111827] border border-slate-800">
      <span class="text-[11px] font-mono text-slate-400 block">ENTRY PRICE</span>
      <strong class="text-sm text-amber-300 font-mono mt-1 block">{brand.startingPriceLabel.split('|')[0]}</strong>
    </div>
  </div>

  <div class="mt-4 p-3.5 rounded-xl bg-[#111827] border border-slate-800 flex flex-wrap items-center justify-between gap-2 text-xs">
    <div class="text-slate-300">
      <span class="text-slate-400 font-mono mr-2">REGIONS ({brand.regionCountText}):</span>
      {brand.regions.join(' · ')}
    </div>
    <div class="text-slate-400 font-mono">
      PAYMENTS: {brand.paymentMethods.join(' / ')}
    </div>
  </div>
</section>
