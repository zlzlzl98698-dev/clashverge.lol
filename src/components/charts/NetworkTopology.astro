---
import type { AirportBrand } from '../../data/brands';

export interface Props {
  brand?: AirportBrand;
  title?: string;
}

const { brand, title } = Astro.props;
const lineLabel = brand ? brand.lineType : 'IEPL / IPLC 内网专线';
const protocolLabel = brand ? brand.protocols.join(' / ') : 'VLESS / Trojan / Hysteria 2';
const exitLabel = brand ? brand.regions.slice(0, 5).join(' · ') : '香港 · 新加坡 · 日本 · 台湾 · 美国';
---

<section
  class="observatory-panel p-5 sm:p-6 my-8"
  aria-label={title || `${brand ? brand.name : 'IEPL专线'} 网络传输路径拓扑图（架构示意）`}
>
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-800">
    <div>
      <h3 class="text-base sm:text-lg font-bold text-slate-100">
        {title || `${brand ? brand.name : '跨境专线'} · Network Path Observatory (架构拓扑示意)`}
      </h3>
      <p class="text-xs font-mono text-slate-400 mt-0.5">
        TOPOLOGY MODE: SCHEMATIC ARCHITECTURE | ANTI-QoS &amp; NATIVE IP ROUTING
      </p>
    </div>
    <span class="px-2.5 py-1 rounded text-[11px] font-mono bg-blue-950/80 text-blue-300 border border-blue-700/60">
      架构概念示意
    </span>
  </div>

  <!-- Visual Topology Flow -->
  <div class="mt-6 grid grid-cols-1 lg:grid-cols-4 gap-4 items-stretch">
    <!-- Node 1: User Device -->
    <div class="p-4 rounded-xl bg-[#111827] border border-slate-800 flex flex-col justify-between">
      <div>
        <span class="text-[11px] font-mono text-sky-400">STAGE 01 // CLIENT</span>
        <h4 class="text-sm font-bold text-slate-100 mt-1">本地用户终端设备</h4>
        <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">
          通过 {brand ? brand.clientSupport : 'Clash Verge Rev / Shadowrocket'} 进行 Rule 规则分流：国内流量直连，受阻流量封装加密。
        </p>
      </div>
      <div class="mt-3 pt-2 border-t border-slate-800/80 text-[11px] font-mono text-slate-300">
        加密协议: {protocolLabel}
      </div>
    </div>

    <!-- Node 2: Domestic BGP Entry -->
    <div class="p-4 rounded-xl bg-[#111827] border border-slate-800 flex flex-col justify-between">
      <div>
        <span class="text-[11px] font-mono text-emerald-400">STAGE 02 // BGP INGRESS</span>
        <h4 class="text-sm font-bold text-slate-100 mt-1">国内多线 BGP 入口</h4>
        <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">
          电信/联通/移动三网就近接入国内中转入口（如广深/沪杭 BGP 机房），隐藏海外真实落地 IP 并降低首跳 RTT。
        </p>
      </div>
      <div class="mt-3 pt-2 border-t border-slate-800/80 text-[11px] font-mono text-emerald-300">
        特性: 三网智能调度 · 隐藏真实IP
      </div>
    </div>

    <!-- Node 3: Cross-Border Dedicated Line -->
    <div class="p-4 rounded-xl bg-gradient-to-b from-blue-950/60 to-[#111827] border-2 border-blue-500/60 flex flex-col justify-between">
      <div>
        <span class="text-[11px] font-mono text-blue-300">STAGE 03 // CROSS-BORDER CORE</span>
        <h4 class="text-sm font-bold text-white mt-1">{lineLabel} 跨境传输</h4>
        <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
          内网以太网/物理专线点对点过境，绕开公网国际出口拥堵与晚高峰 QoS 限速，保障低抖动与低丢包率。
        </p>
      </div>
      <div class="mt-3 pt-2 border-t border-blue-800/60 text-[11px] font-mono text-blue-300 font-semibold">
        ═══ 专线直连 · 晚高峰防QoS ═══
      </div>
    </div>

    <!-- Node 4: Overseas Landing & Services -->
    <div class="p-4 rounded-xl bg-[#111827] border border-slate-800 flex flex-col justify-between">
      <div>
        <span class="text-[11px] font-mono text-purple-400">STAGE 04 // OVERSEAS EGRESS</span>
        <h4 class="text-sm font-bold text-slate-100 mt-1">海外落地原生 IP 出口</h4>
        <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">
          落地节点（{exitLabel}）按策略组分发至 OpenAI/Claude、Netflix 4K 及常规国际互联网。
        </p>
      </div>
      <div class="mt-3 pt-2 border-t border-slate-800/80 text-[11px] font-mono text-purple-300">
        落地: 原生IP解锁 · 流媒体与AI访问
      </div>
    </div>
  </div>

  <p class="mt-4 pt-3 border-t border-slate-800 text-xs text-slate-400 leading-relaxed">
    <strong>技术说明：</strong>本拓扑图为基于品牌公开线路类型（{lineLabel}）与传输协议（{protocolLabel}）绘制的逻辑架构示意，用于解释专线与普通直连的链路差异；具体机房物理跳数以服务商实时路由调度为准。
  </p>
</section>
