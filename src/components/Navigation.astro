---
import { PRIMARY_NAVIGATION } from '../data/navigation';

const currentPath = Astro.url.pathname;

function isSectionActive(sectionUrl: string): boolean {
  return currentPath === sectionUrl || currentPath.startsWith(sectionUrl);
}
---

<nav aria-label="主导航" class="hidden lg:flex items-center gap-1">
  {
    PRIMARY_NAVIGATION.map((section) => {
      const active = isSectionActive(section.url);
      return (
        <div class="relative group">
          <a
            href={section.url}
            class:list={[
              'inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-[15px] font-medium transition-colors',
              active
                ? 'bg-[#EFF6FF] text-[#2563EB] font-semibold'
                : 'text-[#172033] hover:bg-[#F7F9FC] hover:text-[#2563EB]',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            <span>{section.name}</span>
            <svg
              class="w-4 h-4 text-[#64748B] group-hover:text-[#2563EB] group-hover:rotate-180 transition-transform duration-200"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <!-- Dropdown Panel (7 Secondary Topics) -->
          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute left-0 top-full pt-2 w-72 z-50">
            <div class="bg-white rounded-xl border border-[#E5EAF1] shadow-card-hover p-2.5">
              <div class="px-3 py-1.5 mb-1 border-b border-[#E5EAF1] flex items-center justify-between">
                <span class="text-xs font-semibold text-[#2563EB]">{section.heroBadge}</span>
                <a href={section.url} class="text-xs text-[#64748B] hover:text-[#2563EB]">
                  栏目主页 →
                </a>
              </div>
              <ul class="space-y-0.5">
                {section.topics.map((topic) => {
                  const topicActive = currentPath === topic.url;
                  return (
                    <li>
                      <a
                        href={topic.url}
                        class:list={[
                          'flex items-center justify-between px-3 py-2 rounded-lg text-sm transition-colors',
                          topicActive
                            ? 'bg-[#EFF6FF] text-[#2563EB] font-semibold'
                            : 'text-[#172033] hover:bg-[#F7F9FC] hover:text-[#2563EB]',
                        ]}
                      >
                        <span>{topic.name}</span>
                        <span class="text-[11px] text-[#64748B]">{topic.clusters.length} 集群</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        </div>
      );
    })
  }
</nav>
