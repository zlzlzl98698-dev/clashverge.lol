---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="面包屑导航" class="mb-5">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-[#64748B]">
    {
      items.map((item, idx) => {
        const isLast = idx === items.length - 1;
        return (
          <li class="inline-flex items-center gap-1.5">
            {idx > 0 && (
              <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            )}
            {isLast ? (
              <span class="font-medium text-[#172033] line-clamp-1" aria-current="page">
                {item.name}
              </span>
            ) : (
              <a
                href={item.url}
                class="hover:text-[#2563EB] transition-colors whitespace-nowrap"
              >
                {item.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
