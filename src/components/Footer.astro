---
import { SITE_CONFIG } from '../data/site';
import { PRIMARY_NAVIGATION } from '../data/navigation';
import { AIRPORT_BRANDS } from '../data/brands';

const topBrands = AIRPORT_BRANDS.slice(0, 10);
---

<footer class="bg-[#F7F9FC] border-t border-[#E5EAF1] mt-20 text-[#64748B]">
  <div class="editorial-container py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 pb-12 border-b border-[#E5EAF1]">
      <!-- Brand Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5">
          <img
            src="/images/clash-logo.png"
            alt={SITE_CONFIG.brandName}
            class="w-8 h-8 rounded-full object-cover shadow-sm"
            width="32"
            height="32"
          />
          <span class="text-lg font-bold text-[#172033]">{SITE_CONFIG.brandName}</span>
          <span class="text-xs font-mono px-2 py-0.5 rounded bg-white border border-[#E5EAF1] text-[#2563EB]">
            {SITE_CONFIG.domain}
          </span>
        </a>
        <p class="text-sm leading-relaxed text-[#64748B]">
          {SITE_CONFIG.description}
        </p>
        <div class="p-3.5 rounded-xl bg-white border border-[#E5EAF1] text-xs leading-relaxed text-[#64748B]">
          <strong class="text-[#172033]">商业推广与独立评测披露：</strong>
          {SITE_CONFIG.affiliateDisclosure}
        </div>
        <div class="text-xs text-[#64748B] flex flex-wrap items-center gap-4">
          <span>联系编辑部：{SITE_CONFIG.contactEmail}</span>
          <span>数据批次：{SITE_CONFIG.testBatchDate}</span>
        </div>
      </div>

      <!-- 4 Primary Categories & Subtopics -->
      {
        PRIMARY_NAVIGATION.map((section) => (
          <div>
            <h3 class="text-sm font-bold text-[#172033] mb-3">
              <a href={section.url} class="hover:text-[#2563EB] transition-colors">
                {section.name}
              </a>
            </h3>
            <ul class="space-y-2 text-sm">
              {section.topics.map((topic) => (
                <li>
                  <a href={topic.url} class="hover:text-[#2563EB] transition-colors">
                    {topic.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Brand Database Quick Index -->
    <div class="py-6 border-b border-[#E5EAF1]">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="font-semibold text-[#172033] mr-1">热门评测品牌直达：</span>
        {
          topBrands.map((b) => (
            <a
              href={`/brands/${b.slug}/`}
              class="px-2.5 py-1 rounded-md bg-white border border-[#E5EAF1] text-[#64748B] hover:border-[#2563EB] hover:text-[#2563EB] transition-colors"
            >
              {b.name}评测
            </a>
          ))
        }
        <a
          href="/brands/"
          class="px-2.5 py-1 rounded-md bg-[#EFF6FF] text-[#2563EB] font-medium hover:bg-[#2563EB] hover:text-white transition-colors"
        >
          查看全部 31 家品牌数据库 →
        </a>
      </div>
    </div>

    <!-- Bottom Legal & Links -->
    <div class="pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs">
      <p>
        © {new Date().getFullYear()} {SITE_CONFIG.brandName} ({SITE_CONFIG.domain}). 保留所有原创评测与内容矩阵权利。
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/brands/" class="hover:text-[#2563EB]">品牌数据库</a>
        <a href="/articles/" class="hover:text-[#2563EB]">全部文章</a>
        <a href="/reviews/" class="hover:text-[#2563EB]">深度评测</a>
        <a href="/comparisons/" class="hover:text-[#2563EB]">横向对比</a>
        <a href="/guides/" class="hover:text-[#2563EB]">客户端教程</a>
        <a href="/about/" class="hover:text-[#2563EB]">关于我们</a>
        <a href="/privacy/" class="hover:text-[#2563EB]">隐私政策</a>
        <a href="/disclaimer/" class="hover:text-[#2563EB]">使用声明</a>
        <a href="/disclosure/" class="hover:text-[#2563EB]">商业推广披露</a>
        <a href="/sitemap-index.xml" class="hover:text-[#2563EB]">Sitemap</a>
      </div>
    </div>
  </div>

  <!-- Back to top button -->
  <button
    id="back-to-top-btn"
    type="button"
    aria-label="返回页面顶部"
    class="fixed bottom-6 right-6 z-30 hidden items-center justify-center w-10 h-10 rounded-full bg-[#2563EB] text-white shadow-lg hover:bg-[#1D4ED8] transition-all"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 15l7-7 7 7" />
    </svg>
  </button>
</footer>

<script is:inline>
  (function () {
    const topBtn = document.getElementById('back-to-top-btn');
    if (!topBtn) return;
    window.addEventListener('scroll', () => {
      if (window.scrollY > 360) {
        topBtn.classList.remove('hidden');
        topBtn.classList.add('inline-flex');
      } else {
        topBtn.classList.add('hidden');
        topBtn.classList.remove('inline-flex');
      }
    });
    topBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>
