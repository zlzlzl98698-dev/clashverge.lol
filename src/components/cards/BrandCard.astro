---
import type { AirportBrand } from '../../data/brands';
import { SITE_CONFIG } from '../../data/site';

export interface Props {
  brand: AirportBrand;
  compact?: boolean;
}

const { brand, compact = false } = Astro.props;
const hkSpeed = brand.speedRecords.find((r) => r.region === '香港');
---

<div
  class:list={[
    'card-surface p-5 flex flex-col justify-between relative overflow-hidden',
    brand.isPromoted ? 'border-2 border-[#2563EB] bg-gradient-to-b from-[#EFF6FF]/40 to-white' : '',
  ]}
  data-brand-card
  data-name={brand.name.toLowerCase()}
  data-line={brand.lineType}
  data-client={brand.clientSupport}
  data-price={brand.startingMonthlyNum}
  data-verified={brand.verificationStatus}
>
  {brand.isPromoted && (
    <div class="mb-3 -mx-5 -mt-5 px-4 py-1.5 bg-[#2563EB] text-white text-xs font-semibold flex items-center justify-between">
      <span>★ {brand.promotionBadge}</span>
      <span class="text-[10px] opacity-90">含推广链接</span>
    </div>
  )}

  <div>
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        {brand.logo ? (
          <img
            src={brand.logo}
            alt={`${brand.name} 品牌图标`}
            width="48"
            height="48"
            loading="lazy"
            class="w-12 h-12 rounded-xl object-cover border border-[#E5EAF1] bg-white shrink-0"
          />
        ) : (
          <div class="w-12 h-12 rounded-xl bg-[#EFF6FF] text-[#2563EB] font-bold flex items-center justify-center text-lg shrink-0">
            {brand.name.slice(0, 1)}
          </div>
        )}
        <div>
          <h3 class="text-lg font-bold text-[#172033] hover:text-[#2563EB] transition-colors">
            <a href={`/brands/${brand.slug}/`}>{brand.name}</a>
          </h3>
          <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
            <span class="text-xs px-2 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] font-medium">
              {brand.lineType}
            </span>
            <span class="text-xs text-[#64748B]">
              {brand.foundedYear !== '待核实' ? `${brand.foundedYear}年运营` : '年份待核实'}
            </span>
          </div>
        </div>
      </div>

      <span
        class:list={[
          'text-[11px] px-2 py-0.5 rounded-full font-medium shrink-0',
          brand.verificationStatus === 'Measured_2026_10'
            ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
            : brand.verificationStatus === 'Measured_Historical'
              ? 'bg-blue-50 text-blue-700 border border-blue-200'
              : 'bg-slate-100 text-slate-600 border border-slate-200',
        ]}
      >
        {brand.verificationStatus === 'Measured_2026_10'
          ? '2026-10 已实测'
          : brand.verificationStatus === 'Measured_Historical'
            ? '历史实测归档'
            : '基础资料已核'}
      </span>
    </div>

    <div class="mt-4 p-3 rounded-xl bg-[#F7F9FC] border border-[#E5EAF1] grid grid-cols-2 gap-2 text-xs">
      <div>
        <span class="text-[#64748B] block">起步参考价</span>
        <strong class="text-[#172033] font-mono">{brand.startingPriceLabel}</strong>
      </div>
      <div>
        <span class="text-[#64748B] block">香港实测 / 客户端</span>
        <strong class="text-[#2563EB] font-mono">
          {hkSpeed && hkSpeed.downloadMbps
            ? `${hkSpeed.downloadMbps}Mbps (${hkSpeed.latency})`
            : brand.clientSupport}
        </strong>
      </div>
    </div>

    {!compact && (
      <p class="mt-3 text-sm text-[#64748B] line-clamp-2 leading-relaxed">
        {brand.summary}
      </p>
    )}

    <div class="mt-3 flex flex-wrap gap-1.5 text-xs">
      <span class="badge-neutral">协议: {brand.protocols.join('/')}</span>
      <span class="badge-neutral">{brand.clientSupport}</span>
      {brand.couponCode !== '待核实' && (
        <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 font-mono">
          优惠码: {brand.couponCode}
        </span>
      )}
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-[#E5EAF1]">
    <div class="flex items-center gap-2">
      <a
        href={`/brands/${brand.slug}/`}
        class="flex-1 py-2 px-3 rounded-lg border border-[#E5EAF1] bg-white hover:border-[#2563EB] text-center text-xs font-semibold text-[#172033] hover:text-[#2563EB] transition-colors"
      >
        深度评测 & 套餐表
      </a>
      <a
        href={brand.registerUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="py-2 px-3.5 rounded-lg bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-semibold transition-colors shrink-0"
      >
        官网注册 →
      </a>
    </div>
    <p class="mt-1.5 text-[10px] text-[#64748B] truncate" title={SITE_CONFIG.shortDisclosure}>
      {SITE_CONFIG.shortDisclosure}
    </p>
  </div>
</div>
