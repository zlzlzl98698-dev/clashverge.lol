---
import type { UnifiedPost } from '../../utils/content';

export interface Props {
  post: UnifiedPost;
  horizontal?: boolean;
}

const { post, horizontal = false } = Astro.props;
---

<article
  class:list={[
    'card-surface overflow-hidden flex flex-col group',
    horizontal ? ' sm:flex-row sm:items-stretch' : '',
  ]}
>
  <a
    href={post.url}
    class:list={[
      'block overflow-hidden bg-[#F7F9FC] shrink-0 relative',
      horizontal ? 'sm:w-64 aspect-video sm:aspect-auto' : 'aspect-[16/9]',
    ]}
  >
    <img
      src={post.cover}
      alt={post.coverAlt}
      width="640"
      height="360"
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
    />
    <span class="absolute top-3 left-3 badge-category shadow-sm bg-white/95 backdrop-blur-sm">
      {post.categoryLabel}
    </span>
  </a>

  <div class="p-5 flex flex-col flex-1 justify-between">
    <div>
      <div class="flex flex-wrap items-center gap-2 text-xs text-[#64748B] mb-2">
        <time datetime={post.updatedDate}>更新于 {post.updatedDate}</time>
        <span>·</span>
        <span>{post.readingTime}</span>
        {post.pillar && (
          <span class="px-2 py-0.5 rounded bg-blue-50 text-[#2563EB] font-semibold">
            Pillar 专题长文
          </span>
        )}
      </div>

      <h3 class="text-lg font-bold text-[#172033] group-hover:text-[#2563EB] transition-colors line-clamp-2 leading-snug">
        <a href={post.url}>{post.title}</a>
      </h3>

      <p class="mt-2.5 text-sm text-[#64748B] line-clamp-3 leading-relaxed">
        {post.excerpt}
      </p>
    </div>

    <div class="mt-4 pt-3 border-t border-[#E5EAF1] flex items-center justify-between text-xs">
      <span class="text-[#64748B] font-medium">{post.author}</span>
      <a
        href={post.url}
        class="inline-flex items-center gap-1 font-semibold text-[#2563EB] group-hover:translate-x-0.5 transition-transform"
      >
        <span>阅读全文</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
