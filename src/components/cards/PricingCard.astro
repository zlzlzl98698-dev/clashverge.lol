---
import type { AirportBrand } from '../../data/brands';
import { SITE_CONFIG } from '../../data/site';

export interface Props {
  brand: AirportBrand;
  highlightPlanIndex?: number;
}

const { brand, highlightPlanIndex = 0 } = Astro.props;
const featuredPlans = brand.plans.slice(0, 4);
---

<div class="card-surface p-5 flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between gap-2 pb-3 border-b border-[#E5EAF1]">
      <div class="flex items-center gap-2.5">
        {brand.logo && (
          <img
            src={brand.logo}
            alt={brand.name}
            width="36"
            height="36"
            loading="lazy"
            class="w-9 h-9 rounded-lg object-cover border border-[#E5EAF1]"
          />
        )}
        <div>
          <h3 class="text-base font-bold text-[#172033]">
            <a href={`/brands/${brand.slug}/`} class="hover:text-[#2563EB]">{brand.name} 套餐概览</a>
          </h3>
          <span class="text-xs text-[#64748B]">{brand.lineType} · {brand.clientSupport}</span>
        </div>
      </div>
      {brand.couponCode !== '待核实' && (
        <span class="text-xs font-mono px-2 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] font-semibold">
          码: {brand.couponCode}
        </span>
      )}
    </div>

    <div class="mt-3 space-y-2">
      {featuredPlans.map((plan, idx) => (
        <div
          class:list={[
            'p-2.5 rounded-xl border text-xs flex items-center justify-between gap-2',
            idx === highlightPlanIndex
              ? 'bg-[#EFF6FF]/60 border-blue-200'
              : 'bg-[#F7F9FC] border-[#E5EAF1]',
          ]}
        >
          <div>
            <span class="font-semibold text-[#172033] block">{plan.name}</span>
            <span class="text-[11px] text-[#64748B]">{plan.billingCycle} · {plan.resetPolicy}</span>
          </div>
          <div class="text-right">
            <span class="font-mono font-bold text-sm text-[#2563EB] block">{plan.price}</span>
            <span class="font-mono text-[11px] text-[#172033]">{plan.traffic}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-[#E5EAF1]">
    <div class="flex items-center justify-between gap-2">
      <a
        href={`/brands/${brand.slug}/`}
        class="text-xs font-semibold text-[#172033] hover:text-[#2563EB]"
      >
        查看完整套餐与注意项 →
      </a>
      <a
        href={brand.registerUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="px-3 py-1.5 rounded-lg bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-semibold transition-colors"
      >
        直达官网
      </a>
    </div>
    <p class="mt-1.5 text-[10px] text-[#64748B]">{SITE_CONFIG.shortDisclosure}</p>
  </div>
</div>
