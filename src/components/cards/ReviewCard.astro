---
import type { UnifiedPost } from '../../utils/content';
import { getBrandBySlug } from '../../data/brands';

export interface Props {
  post: UnifiedPost;
}

const { post } = Astro.props;
const primaryBrandSlug = post.relatedBrands?.[0] || 'guangsuyun';
const brand = getBrandBySlug(primaryBrandSlug);
---

<article class="card-surface p-5 flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        {brand?.logo && (
          <img
            src={brand.logo}
            alt={brand.name}
            width="28"
            height="28"
            loading="lazy"
            class="w-7 h-7 rounded-lg object-cover border border-[#E5EAF1]"
          />
        )}
        <span class="badge-category">{brand ? `${brand.name}深度评测` : '品牌实测'}</span>
      </div>
      <span class="text-xs font-mono text-[#64748B]">{post.testDate}</span>
    </div>

    <h3 class="text-lg font-bold text-[#172033] group-hover:text-[#2563EB] transition-colors line-clamp-2 leading-snug">
      <a href={post.url}>{post.title}</a>
    </h3>

    <p class="mt-2.5 text-sm text-[#64748B] line-clamp-3 leading-relaxed">
      {post.excerpt}
    </p>

    {brand && (
      <div class="mt-3.5 pt-3 border-t border-[#E5EAF1] grid grid-cols-2 gap-2 text-xs">
        <div class="bg-[#F7F9FC] px-2.5 py-1.5 rounded-lg">
          <span class="text-[#64748B] block">线路与协议</span>
          <strong class="text-[#172033]">{brand.lineType} · {brand.protocols[0]}</strong>
        </div>
        <div class="bg-[#F7F9FC] px-2.5 py-1.5 rounded-lg">
          <span class="text-[#64748B] block">价格档位</span>
          <strong class="text-[#2563EB] font-mono">{brand.startingPriceLabel.split('|')[0]}</strong>
        </div>
      </div>
    )}
  </div>

  <div class="mt-4 pt-3 border-t border-[#E5EAF1] flex items-center justify-between text-xs">
    <span class="text-[#64748B]">{post.readingTime} · {post.author}</span>
    <a href={post.url} class="font-semibold text-[#2563EB] hover:underline">
      阅读评测报告 →
    </a>
  </div>
</article>
