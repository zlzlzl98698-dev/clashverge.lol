---
import type { SecondaryTopic } from '../../data/navigation';

export interface Props {
  topic: SecondaryTopic;
}

const { topic } = Astro.props;
---

<div class="card-surface p-5 flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <span class="badge-category">{topic.primaryKeyword}</span>
      <span class="text-[11px] font-mono text-[#64748B]">{topic.searchIntent}</span>
    </div>

    <h3 class="text-lg font-bold text-[#172033] group-hover:text-[#2563EB] transition-colors">
      <a href={topic.url}>{topic.name}</a>
    </h3>

    <p class="mt-2 text-sm text-[#64748B] line-clamp-3 leading-relaxed">
      {topic.description}
    </p>

    <div class="mt-3.5 space-y-1.5">
      {topic.clusters.map((c) => (
        <div class="text-xs px-2.5 py-1.5 rounded-lg bg-[#F7F9FC] border border-[#E5EAF1] text-[#172033] flex items-center justify-between gap-2">
          <span class="truncate font-medium">▸ {c.name}</span>
          <span class="text-[10px] text-[#2563EB] shrink-0">{c.targetKeyword}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-[#E5EAF1] flex items-center justify-between text-xs">
    <span class="text-[#64748B]">关联品牌 {topic.featuredBrandSlugs.length} 家</span>
    <a
      href={topic.url}
      class="font-semibold text-[#2563EB] group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1"
    >
      <span>浏览专题</span>
      <span>→</span>
    </a>
  </div>
</div>
