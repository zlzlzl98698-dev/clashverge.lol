---
import type { UnifiedPost } from '../../utils/content';

export interface Props {
  post: UnifiedPost;
}

const { post } = Astro.props;
---

<article class="card-surface overflow-hidden group grid grid-cols-1 lg:grid-cols-12 bg-gradient-to-br from-white via-white to-[#EFF6FF]/40">
  <a
    href={post.url}
    class="lg:col-span-7 block overflow-hidden bg-[#0B1120] aspect-[16/9] lg:aspect-auto relative"
  >
    <img
      src={post.cover}
      alt={post.coverAlt}
      width="800"
      height="450"
      loading="eager"
      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
    />
    <div class="absolute top-4 left-4 flex flex-wrap gap-2">
      <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#2563EB] text-white shadow">
        编辑部深度精选
      </span>
      <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/95 text-[#172033] shadow">
        {post.categoryLabel}
      </span>
    </div>
  </a>

  <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between">
    <div>
      <div class="flex items-center gap-2 text-xs text-[#64748B] mb-3">
        <time datetime={post.updatedDate}>核实更新：{post.updatedDate}</time>
        <span>·</span>
        <span>阅读约 {post.readingTime}</span>
      </div>

      <h3 class="text-xl sm:text-2xl font-extrabold text-[#172033] group-hover:text-[#2563EB] transition-colors leading-snug">
        <a href={post.url}>{post.title}</a>
      </h3>

      <p class="mt-3.5 text-sm sm:text-[15.5px] text-[#64748B] leading-relaxed line-clamp-4">
        {post.excerpt}
      </p>

      {post.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {post.tags.slice(0, 4).map((tag) => (
            <span class="badge-neutral">#{tag}</span>
          ))}
        </div>
      )}
    </div>

    <div class="mt-6 pt-4 border-t border-[#E5EAF1] flex items-center justify-between">
      <div class="text-xs text-[#64748B]">
        <span class="font-semibold text-[#172033]">{post.author}</span>
        <span class="block text-[11px]">基于 {post.testDate} 实测数据批次</span>
      </div>

      <a
        href={post.url}
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs sm:text-sm font-semibold transition-colors"
      >
        <span>进入深度阅读</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</article>
