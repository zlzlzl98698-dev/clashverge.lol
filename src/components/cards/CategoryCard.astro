---
import type { PrimaryNavSection } from '../../data/navigation';

export interface Props {
  section: PrimaryNavSection;
}

const { section } = Astro.props;
---

<div class="card-surface p-6 flex flex-col justify-between group relative overflow-hidden">
  <div>
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="badge-category">{section.heroBadge}</span>
      <span class="text-xs font-mono text-[#64748B]">{section.topics.length} 个二级专题</span>
    </div>

    <h3 class="text-xl font-bold text-[#172033] group-hover:text-[#2563EB] transition-colors">
      <a href={section.url}>{section.name}</a>
    </h3>

    <p class="mt-2 text-sm text-[#64748B] line-clamp-2 leading-relaxed">
      {section.description}
    </p>

    <div class="mt-4 pt-3 border-t border-[#E5EAF1] flex flex-wrap gap-1.5">
      {section.topics.map((topic) => (
        <a
          href={topic.url}
          class="px-2.5 py-1 rounded-md text-xs bg-[#F7F9FC] hover:bg-[#EFF6FF] text-[#172033] hover:text-[#2563EB] border border-[#E5EAF1] transition-colors"
        >
          {topic.name}
        </a>
      ))}
    </div>
  </div>

  <div class="mt-5 pt-3 border-t border-[#E5EAF1] flex items-center justify-between text-xs">
    <span class="text-[#64748B]">涵盖 {section.topics.length * 2} 个三级内容集群</span>
    <a
      href={section.url}
      class="inline-flex items-center gap-1 font-semibold text-[#2563EB] group-hover:translate-x-0.5 transition-transform"
    >
      <span>进入专栏</span>
      <span>→</span>
    </a>
  </div>
</div>
