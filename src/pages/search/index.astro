---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getAllPublishedPosts } from '../../utils/content';
import { AIRPORT_BRANDS } from '../../data/brands';

const allPosts = await getAllPublishedPosts();

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '站内全文搜索', url: '/search/' },
];

const quickIndex = [
  ...allPosts.map((p) => ({
    type: '原创文章',
    title: p.title,
    url: p.url,
    excerpt: p.excerpt,
    keywords: `${p.title} ${p.primaryKeyword} ${p.tags.join(' ')} ${p.categoryLabel}`,
    date: p.updatedDate,
  })),
  ...AIRPORT_BRANDS.map((b) => ({
    type: '品牌档案',
    title: `${b.name} (${b.englishName}) 深度评测与套餐核实`,
    url: `/brands/${b.slug}/`,
    excerpt: `${b.lineType} · ${b.startingPriceLabel} · 优惠码: ${b.couponCode} · ${b.summary}`,
    keywords: `${b.name} ${b.englishName} ${b.slug} ${b.lineType} ${b.protocols.join(' ')} ${b.couponCode}`,
    date: b.updatedDate,
  })),
];
---

<BaseLayout
  title="站内全文搜索：检索31家机场品牌、Clash教程与评测文章 | clash订阅"
  description="通过 Pagefind 静态全文搜索引擎快速查找 clash订阅 站内的原创评测文章、31家机场套餐优惠码、Clash Verge Rev 教程与排障指南。"
  breadcrumbs={breadcrumbs}
  pagefindIgnore={true}
>
  <section class="bg-[#F7F9FC] border-b border-[#E5EAF1] py-10">
    <div class="editorial-container">
      <Breadcrumb items={breadcrumbs} />
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#172033]">
        站内全文搜索 (Pagefind 中文检索引擎)
      </h1>
      <p class="mt-2 text-sm sm:text-base text-[#64748B]">
        支持搜索文章标题、正文内容、品牌名称、传输协议（如 VLESS、Hysteria 2）、优惠码及报错关键词。
      </p>

      <!-- Custom Editorial Search Input -->
      <div class="mt-6 max-w-3xl">
        <div class="relative flex items-center">
          <svg
            class="w-5 h-5 text-[#64748B] absolute left-4 pointer-events-none"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <input
            id="site-search-input"
            type="search"
            placeholder="输入中文或英文关键词：如 光速云、IEPL、不限时、Timeout、Shadowrocket..."
            aria-label="输入搜索关键词"
            class="w-full pl-12 pr-28 py-4 rounded-2xl border-2 border-[#E5EAF1] bg-white text-base text-[#172033] shadow-card focus:border-[#2563EB] focus:outline-none"
          />
          <button
            id="site-search-clear"
            type="button"
            class="hidden absolute right-20 px-2 py-1 text-xs text-[#64748B] hover:text-[#172033]"
          >
            清空
          </button>
          <button
            id="site-search-btn"
            type="button"
            class="absolute right-2 px-4 py-2.5 rounded-xl bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-sm font-semibold transition-colors"
          >
            搜索
          </button>
        </div>

        <!-- Hot Search Tags -->
        <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
          <span class="text-[#64748B] font-medium">快速热词：</span>
          {['光速云', 'IEPL', '不限时', 'Clash Verge', 'Hysteria 2', 'Timeout', '5.6元', 'ChatGPT', '小火箭', '跑路预警'].map((kw) => (
            <button
              type="button"
              data-hot-kw={kw}
              class="px-2.5 py-1 rounded-md bg-white border border-[#E5EAF1] text-[#172033] hover:border-[#2563EB] hover:text-[#2563EB] transition-colors"
            >
              {kw}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="editorial-container py-10">
    <div class="mb-4 flex items-center justify-between text-xs text-[#64748B]">
      <span id="search-status-label">显示全站精选索引记录（共 {quickIndex.length} 条可检索内容）</span>
      <span id="pagefind-engine-badge" class="font-mono text-[#2563EB]">ENGINE: PAGEFIND + INSTANT INDEX</span>
    </div>

    <!-- Pagefind Full-Text Dynamic Results Container -->
    <div id="pagefind-results-container" class="hidden space-y-4 mb-8"></div>

    <!-- Instant Structured Cards Container -->
    <div id="instant-results-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {quickIndex.map((item) => (
        <article
          class="card-surface p-5 flex flex-col justify-between"
          data-search-item
          data-search-text={`${item.title} ${item.excerpt} ${item.keywords}`.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span
                class:list={[
                  'px-2.5 py-0.5 rounded-full text-xs font-semibold',
                  item.type === '品牌档案'
                    ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                    : 'bg-[#EFF6FF] text-[#2563EB]',
                ]}
              >
                {item.type}
              </span>
              <span class="text-xs font-mono text-[#64748B]">{item.date}</span>
            </div>
            <h2 class="text-base sm:text-lg font-bold text-[#172033] hover:text-[#2563EB] transition-colors">
              <a href={item.url}>{item.title}</a>
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-[#64748B] line-clamp-2 leading-relaxed">
              {item.excerpt}
            </p>
          </div>
          <div class="mt-3 pt-2.5 border-t border-[#E5EAF1] flex items-center justify-between text-xs">
            <span class="font-mono text-[#64748B] truncate">{item.url}</span>
            <a href={item.url} class="font-semibold text-[#2563EB] shrink-0 ml-2">
              直达页面 →
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty Result State -->
    <div id="search-empty-box" class="hidden card-surface p-12 text-center space-y-3">
      <p class="text-lg font-bold text-[#172033]">未找到与该关键词匹配的文章或品牌</p>
      <p class="text-sm text-[#64748B]">
        建议尝试简短关键词（例如“光速云”、“IEPL”、“订阅”、“Timeout”），或直接前往品牌数据库筛选。
      </p>
      <div class="pt-2 flex justify-center gap-3">
        <a href="/brands/" class="px-4 py-2 rounded-xl bg-[#2563EB] text-white text-xs font-semibold">
          浏览 31 家品牌数据库
        </a>
        <a href="/articles/" class="px-4 py-2 rounded-xl border border-[#E5EAF1] text-xs font-semibold text-[#172033]">
          浏览全部文章
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const input = document.getElementById('site-search-input');
    const clearBtn = document.getElementById('site-search-clear');
    const searchBtn = document.getElementById('site-search-btn');
    const statusLabel = document.getElementById('search-status-label');
    const pfContainer = document.getElementById('pagefind-results-container');
    const instantGrid = document.getElementById('instant-results-grid');
    const emptyBox = document.getElementById('search-empty-box');
    const items = Array.from(document.querySelectorAll('[data-search-item]'));
    const hotBtns = Array.from(document.querySelectorAll('[data-hot-kw]'));

    let pagefindModule = null;

    async function initPagefind() {
      try {
        pagefindModule = await import('/pagefind/pagefind.js');
        await pagefindModule.init();
      } catch (e) {
        // Fallback to instant index if pagefind bundle is not yet loaded
      }
    }
    initPagefind();

    async function runSearch(query) {
      const q = (query || '').trim().toLowerCase();
      if (clearBtn) clearBtn.classList.toggle('hidden', !q);

      // 1. Filter instant cards
      let matchCount = 0;
      items.forEach((el) => {
        const text = el.getAttribute('data-search-text') || '';
        const matched = !q || text.includes(q);
        el.classList.toggle('hidden', !matched);
        if (matched) matchCount++;
      });

      // 2. Also query Pagefind full-text index for deep paragraph snippets
      let pfCount = 0;
      if (q && pagefindModule && pfContainer) {
        try {
          const searchRes = await pagefindModule.search(q);
          if (searchRes && searchRes.results && searchRes.results.length > 0) {
            pfCount = searchRes.results.length;
            const topData = await Promise.all(
              searchRes.results.slice(0, 6).map((r) => r.data())
            );
            pfContainer.innerHTML =
              '<h3 class="text-sm font-bold text-[#2563EB] mb-2">Pagefind 正文段落全文命中结果：</h3>' +
              '<div class="grid grid-cols-1 md:grid-cols-2 gap-4">' +
              topData
                .map(
                  (d) => `
                <a href="${d.url}" class="card-surface p-4 block hover:border-[#2563EB]">
                  <div class="text-sm font-bold text-[#172033]">${d.meta?.title || d.url}</div>
                  <p class="mt-1.5 text-xs text-[#64748B] leading-relaxed">${d.excerpt || ''}</p>
                </a>
              `
                )
                .join('') +
              '</div>';
            pfContainer.classList.remove('hidden');
          } else {
            pfContainer.classList.add('hidden');
            pfContainer.innerHTML = '';
          }
        } catch {
          pfContainer.classList.add('hidden');
        }
      } else if (pfContainer) {
        pfContainer.classList.add('hidden');
        pfContainer.innerHTML = '';
      }

      const totalVisible = matchCount + pfCount;
      if (statusLabel) {
        statusLabel.textContent = q
          ? `关键词「${query}」共匹配到 ${matchCount} 条核心档案${pfCount ? ` 及 ${pfCount} 篇全文段落` : ''}`
          : `显示全站精选索引记录（共 ${items.length} 条可检索内容）`;
      }
      if (emptyBox) {
        emptyBox.classList.toggle('hidden', totalVisible > 0);
      }
    }

    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get('q') || '';
    if (initialQ && input) {
      input.value = initialQ;
      setTimeout(() => runSearch(initialQ), 120);
    }

    input?.addEventListener('input', (e) => runSearch(e.target.value));
    searchBtn?.addEventListener('click', () => runSearch(input?.value || ''));
    clearBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      runSearch('');
    });
    hotBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const kw = btn.getAttribute('data-hot-kw') || '';
        if (input) input.value = kw;
        runSearch(kw);
      });
    });
  })();
</script>
