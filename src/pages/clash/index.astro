---
import CategoryLayout from '../../layouts/CategoryLayout.astro';
import { getPrimarySection } from '../../data/navigation';
import { getPostsByCategory } from '../../utils/content';
import { PROXY_CLIENTS, CLIENT_PLATFORMS } from '../../data/clients';

const section = getPrimarySection('clash');
const posts = await getPostsByCategory('clash');

const faq = [
  {
    q: '2026年电脑端应该下载哪款 Clash 客户端？',
    a: 'Windows、macOS 与 Linux 桌面端首选 Clash Verge Rev（基于 Tauri 2 与 Mihomo 内核）或 FlClash。原版 Clash for Windows 已停更且不支持 VLESS 与 Hysteria 2 协议。',
  },
  {
    q: '苹果 MacBook 安装 Clash Verge Rev 时应该选 aarch64 还是 x64？',
    a: '搭载 M1、M2、M3、M4 芯片的 Apple Silicon Mac 请下载 `aarch64.dmg`；老款 Intel 处理器 Mac 请下载 `x64.dmg`。',
  },
];
---

<CategoryLayout section={section} posts={posts} faq={faq}>
  <div slot="category-lead" class="card-surface p-6 bg-[#F7F9FC]">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <div>
        <h2 class="text-lg font-bold text-[#172033]">
          2026 全平台代理客户端核实数据库（共收录 {PROXY_CLIENTS.length} 款工具）
        </h2>
        <p class="text-xs text-[#64748B]">
          按操作系统分类展示底层核心、许可证状态、架构选型与官方项目渠道
        </p>
      </div>
      <a href="/clash/download/" class="text-xs font-semibold text-[#2563EB] hover:underline">
        查看安装包架构选型指南 →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {CLIENT_PLATFORMS.map((platform) => {
        const list = PROXY_CLIENTS.filter((c) => c.platforms.includes(platform));
        return (
          <div class="p-4 rounded-xl bg-white border border-[#E5EAF1] space-y-2.5">
            <div class="flex items-center justify-between border-b border-[#E5EAF1] pb-2">
              <strong class="text-sm text-[#172033]">{platform}</strong>
              <span class="text-[11px] font-mono text-[#2563EB]">{list.length} 款</span>
            </div>
            <ul class="space-y-1.5 text-xs">
              {list.map((c) => (
                <li class="flex items-center justify-between gap-2">
                  <a href={c.guideUrl} class="font-semibold text-[#172033] hover:text-[#2563EB] truncate">
                    {c.name}
                  </a>
                  <span
                    class:list={[
                      'text-[10px] px-1.5 py-0.5 rounded shrink-0',
                      c.maintenanceStatus === '活跃推荐'
                        ? 'bg-emerald-50 text-emerald-700'
                        : c.maintenanceStatus.includes('受限') || c.maintenanceStatus.includes('关注')
                          ? 'bg-amber-50 text-amber-800'
                          : 'bg-slate-100 text-slate-600',
                    ]}
                  >
                    {c.coreType.split(' ')[0]} · {c.maintenanceStatus}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</CategoryLayout>
