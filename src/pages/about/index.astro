---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_CONFIG } from '../../data/site';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '关于我们与评测方法论', url: '/about/' },
];

const seoTitle = '关于 clash订阅 · 独立评测实验室、网络测试环境与商业披露准则';
const seoDesc = '深入了解 clash订阅（clashverge.lol）的测试基础设施、三大运营商晚高峰测速环境、IEPL/IPLC专线核查方法及广告与独立评测分离准则。';
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  breadcrumbs={breadcrumbs}
  schemaType="Article"
>
  <div class="editorial-container py-10 sm:py-14 max-w-4xl">
    <Breadcrumb items={breadcrumbs} />

    <header class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-[#2563EB] border border-blue-200 mb-4">
        E-E-A-T 权威凭证与透明度公开
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#172033] tracking-tight leading-tight">
        关于 clash订阅 · 评测实验室与网络工具基准方法论
      </h1>
      <p class="mt-3 text-base sm:text-lg text-[#64748B] leading-relaxed">
        建立以实测抓包、晚高峰测速与真实价格核验为核心的中文网络代理工具独立知识库。
      </p>
    </header>

    <div class="p-5 sm:p-6 rounded-2xl bg-[#F7F9FC] border-l-4 border-[#2563EB] mb-12">
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#2563EB] mb-2 font-mono">
        Answer-First 核心原则与立场承诺
      </h2>
      <p class="text-sm sm:text-base text-[#172033]/90 leading-relaxed">
        clash订阅（clashverge.lol）坚持“数据可复现、成本真实核算、广告明确标识”三项基本原则。所有测速数据均在真实家庭宽带晚高峰场景下采集，绝不将商家的宣称口号直接当作实测结论，绝不为了商业佣金隐瞒节点的晚高峰掉速、退款限制或协议风控隐患。
      </p>
    </div>

    <div class="space-y-12 text-[#172033] leading-relaxed">
      <!-- 实验室测试环境 -->
      <section>
        <h2 class="text-2xl font-bold text-[#172033] mb-4 pb-2 border-b border-[#E5EAF1]">
          一、 实验室硬件与测试网络环境
        </h2>
        <p class="text-sm sm:text-base text-[#64748B] mb-4">
          为了排除测试机算力瓶颈与本地 WiFi 信号干扰，所有节点测速与延迟基准均在以下物理测试基准上采集：
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div class="p-4 rounded-xl border border-[#E5EAF1] bg-white">
            <h3 class="font-bold text-[#172033] mb-1">测试骨干宽带接入</h3>
            <ul class="space-y-1.5 text-xs text-[#64748B]">
              <li>• 中国电信 1000M FTTH（南方骨干入口）</li>
              <li>• 中国联通 1000M FTTH（北方骨干入口）</li>
              <li>• 中国移动 1000M FTTH（用于测试移动中转链路穿透力）</li>
            </ul>
          </div>
          <div class="p-4 rounded-xl border border-[#E5EAF1] bg-white">
            <h3 class="font-bold text-[#172033] mb-1">测试终端与网络硬件</h3>
            <ul class="space-y-1.5 text-xs text-[#64748B]">
              <li>• 路由网关：ASUS RT-AX86U / GL.iNet MT3000（跑原生 TUN 模式）</li>
              <li>• 客户端平台：Windows 11 (Clash Verge Rev) / macOS (Mihomo Party)</li>
              <li>• 测速探针：Speedtest CLI 官方节点 + 自建跨境 iPerf3 测速端</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- 核心评测维度 -->
      <section>
        <h2 class="text-2xl font-bold text-[#172033] mb-4 pb-2 border-b border-[#E5EAF1]">
          二、 31 家品牌数据库的 5 大核验标准
        </h2>
        <div class="space-y-4">
          <div class="p-4 rounded-xl bg-white border border-[#E5EAF1]">
            <h3 class="font-bold text-[#172033] text-sm sm:text-base mb-1">1. 晚高峰速率与延迟（20:00 - 23:00）</h3>
            <p class="text-xs sm:text-sm text-[#64748B]">
              非高峰期的带宽表现不具备代表性。我们重点记录晚高峰满载时段香港、日本、新加坡、美国四大核心区域节点的丢包率与 4K/8K 视频缓冲首屏延迟。
            </p>
          </div>
          <div class="p-4 rounded-xl bg-white border border-[#E5EAF1]">
            <h3 class="font-bold text-[#172033] text-sm sm:text-base mb-1">2. 专线架构与协议纯度真实性</h3>
            <p class="text-xs sm:text-sm text-[#64748B]">
              通过追踪跨境路由跳数与出口 ASN，验证其是否为真实内网 IEPL/IPLC 跨境物理专线，区分廉价公网直连中转节点与专线节点。
            </p>
          </div>
          <div class="p-4 rounded-xl bg-white border border-[#E5EAF1]">
            <h3 class="font-bold text-[#172033] text-sm sm:text-base mb-1">3. AI 与流媒体解锁动态追踪</h3>
            <p class="text-xs sm:text-sm text-[#64748B]">
              实际运行测试脚本核验 OpenAI (ChatGPT/Sora)、Anthropic (Claude 3.5 Sonnet)、Google Gemini 及 Netflix、Disney+ 区域库的解锁稳定性，不以静态宣称为准。
            </p>
          </div>
          <div class="p-4 rounded-xl bg-white border border-[#E5EAF1]">
            <h3 class="font-bold text-[#172033] text-sm sm:text-base mb-1">4. 真实计费周期与倍率审计</h3>
            <p class="text-xs sm:text-sm text-[#64748B]">
              拆解商家宣传的“低至 X 元”，明确区分按月标准订阅价与三年付折算价，标注 1x 流量倍率与高倍率节点的流量扣除实际成本。
            </p>
          </div>
          <div class="p-4 rounded-xl bg-white border border-[#E5EAF1]">
            <h3 class="font-bold text-[#172033] text-sm sm:text-base mb-1">5. 资金安全与运营年限风控</h3>
            <p class="text-xs sm:text-sm text-[#64748B]">
              核查各品牌创办年限（如光速云 2020 年运营至今）、退款政策友好度，向新手用户强力推行“月付测试、避免多年期大额充值”的资金风控方案。
            </p>
          </div>
        </div>
      </section>

      <!-- 商业推广与独立评测准则 -->
      <section>
        <h2 class="text-2xl font-bold text-[#172033] mb-4 pb-2 border-b border-[#E5EAF1]">
          三、 商业模式与推广声明
        </h2>
        <div class="p-5 rounded-xl bg-amber-50/70 border border-amber-200/80 text-xs sm:text-sm text-amber-900 space-y-3 leading-relaxed">
          <p>
            • <strong>推广佣金说明</strong>：本站部分品牌外跳链接包含联盟推广标识（Affiliate Links）。当您通过本站链接前往相关品牌注册购买时，本站可能会获得服务商支付的技术支持佣金。该佣金由服务商支出，<strong>绝不会增加您的实际购买费用</strong>。
          </p>
          <p>
            • <strong>评测独立性承诺</strong>：商业推广合作不影响本站的独立测试结论。若某个合作品牌发生晚高峰拥塞或故障，评测页面将如实披露其局限性，确保读者享有知情权。
          </p>
          <p>
            • <strong>合规跳板架构</strong>：为了防范外链网络关联与保护读者浏览隐私，所有外部引流链接均通过站内专用安全中转路由（<code>/go/</code>）分发，并附带 <code>rel="nofollow sponsored noopener"</code> 标记。
          </p>
        </div>
      </section>

      <!-- 联络与勘误 -->
      <section>
        <h2 class="text-2xl font-bold text-[#172033] mb-4 pb-2 border-b border-[#E5EAF1]">
          四、 编辑部联络与数据勘误
        </h2>
        <p class="text-sm sm:text-base text-[#64748B] mb-4">
          网络代理服务套餐与链路频繁变更。如果您发现某家品牌套餐价格调整、优惠码失效或线路变更，欢迎向本站编辑部反馈更新：
        </p>
        <div class="p-4 rounded-xl bg-white border border-[#E5EAF1] flex items-center justify-between flex-wrap gap-4">
          <div>
            <div class="text-xs text-[#64748B]">编辑部与数据勘误邮箱</div>
            <a href={`mailto:${SITE_CONFIG.contactEmail}`} class="text-base font-bold text-[#2563EB] hover:underline">
              {SITE_CONFIG.contactEmail}
            </a>
          </div>
          <div class="text-xs text-[#64748B]">
            数据最新基准批次：<span class="font-mono font-semibold text-[#172033]">{SITE_CONFIG.testBatchDate}</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
