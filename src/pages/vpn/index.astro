---
import CategoryLayout from '../../layouts/CategoryLayout.astro';
import { getPrimarySection } from '../../data/navigation';
import { getPostsByCategory } from '../../utils/content';

const section = getPrimarySection('vpn');
const posts = await getPostsByCategory('vpn');

const faq = [
  {
    q: '在中国大陆使用，传统海外 VPN 软件和 IEPL 专线机场哪个连通率更高？',
    a: 'IEPL 专线机场连通率与速率远高于传统海外商业 VPN。传统 VPN 采用 OpenVPN/WireGuard 协议直连海外公网，握手特征明显易被阻断；而专线机场采用 VLESS/Trojan/Hysteria 2 协议并通过国内 BGP 入口进入内网专线过境，且支持国内直连、国外代理智能分流。',
  },
  {
    q: '不想学习 Clash 订阅配置，有哪些自带一键连接客户端的 VPN/机场？',
    a: '可以选择同时提供自研一键客户端与通用订阅的「光速云」、「梯子云」，或者提供免配置专属客户端的「飞猫云」、「无忧链接」、「Firefly」、「闪跃」。',
  },
];
---

<CategoryLayout section={section} posts={posts} faq={faq}>
  <div slot="category-lead" class="card-surface p-6 bg-gradient-to-r from-[#EFF6FF]/80 via-white to-[#F7F9FC]">
    <h2 class="text-lg font-bold text-[#172033] mb-3">
      三大跨区方案架构速查：传统 VPN vs 网游加速器 vs 专线机场
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm">
      <div class="p-4 rounded-xl bg-white border border-blue-200">
        <strong class="text-[#2563EB] block mb-1">1. IEPL/IPLC 专线机场 (推荐主力)</strong>
        <p class="text-[#64748B]">
          支持智能规则分流（国内直连不减速），香港延迟低至 21–27ms，兼顾网页、AI 工具、4K 流媒体与终端开发加速。
        </p>
      </div>
      <div class="p-4 rounded-xl bg-white border border-[#E5EAF1]">
        <strong class="text-[#172033] block mb-1">2. 官方一键专属客户端品牌</strong>
        <p class="text-[#64748B]">
          操作体验与传统 VPN 完全一致（下载登录即连），无需配置订阅链接，适合纯新手与移动端用户。
        </p>
      </div>
      <div class="p-4 rounded-xl bg-white border border-[#E5EAF1]">
        <strong class="text-[#172033] block mb-1">3. 合规网游加速器</strong>
        <p class="text-[#64748B]">
          仅劫持特定外服游戏进程 UDP 流量，无法访问 Google、YouTube 或 ChatGPT，适合与 Clash 规则模式搭配共存。
        </p>
      </div>
    </div>
  </div>
</CategoryLayout>
