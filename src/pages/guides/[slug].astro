---
import { render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getAllPublishedPosts, type UnifiedPost } from '../../utils/content';

export async function getStaticPaths() {
  const allPosts = await getAllPublishedPosts();
  const guidePosts = allPosts.filter((p) => p.collection === 'guides');

  return guidePosts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts },
  }));
}

interface Props {
  post: UnifiedPost;
  allPosts: UnifiedPost[];
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post.rawEntry);

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.category === post.category)
  .slice(0, 6);
---

<GuideLayout post={post} headings={headings} relatedPosts={relatedPosts}>
  <Content />
</GuideLayout>
