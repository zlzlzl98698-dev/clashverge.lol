---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_CONFIG } from '../../data/site';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '隐私政策', url: '/privacy/' },
];
---

<BaseLayout
  title="隐私政策 (Privacy Policy) | clash订阅"
  description="clash订阅（clashverge.lol）关于访问者隐私保护、静态页面无追踪原则及外部链接跳转的说明。"
  breadcrumbs={breadcrumbs}
>
  <div class="editorial-container py-12 max-w-4xl">
    <Breadcrumb items={breadcrumbs} />
    <h1 class="text-3xl font-extrabold text-[#172033] mb-6">隐私政策 (Privacy Policy)</h1>
    <div class="article-prose card-surface p-6 sm:p-8">
      <p>最后更新日期：{SITE_CONFIG.updatedDate}</p>
      <h2>一、静态内容架构与零个人敏感信息收集</h2>
      <p>
        <strong>{SITE_CONFIG.brandName} ({SITE_CONFIG.domain})</strong> 采用全静态 HTML 构建（Astro Static Output）与本地浏览器端全文检索（Pagefind）。本站不设用户注册系统、不收集访问者的姓名、电话、身份证号或支付卡密码。
      </p>
      <h2>二、站内搜索与筛选数据处理</h2>
      <p>
        当您在本站使用站内搜索（<code>/search/</code>）或品牌多维筛选（<code>/brands/</code>）功能时，检索匹配过程在您的本地浏览器端通过静态索引切片完成，不会将您的搜索词上传至第三方商业画像数据库。
      </p>
      <h2>三、外部品牌链接与第三方网站隐私</h2>
      <p>
        本站文章及品牌数据库中包含指向第三方网络服务商（机场品牌官网）或 GitHub 开源仓库的外部链接。当您点击该类外部链接离开本站后，您在第三方网站的注册与支付行为受该第三方服务商自身的隐私政策约束。本站建议用户在注册任何第三方网络服务时，使用独立密码并注意个人信息保护。
      </p>
      <h2>四、联系方式</h2>
      <p>
        如对本隐私政策有任何疑问，请通过电子邮件联系编辑部：<code>{SITE_CONFIG.contactEmail}</code>。
      </p>
    </div>
  </div>
</BaseLayout>
