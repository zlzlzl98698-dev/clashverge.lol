---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import CompactArticleCard from '../components/cards/CompactArticleCard.astro';
import BrandCard from '../components/cards/BrandCard.astro';
import FAQSection from '../components/FAQSection.astro';
import BrandCTA from '../components/BrandCTA.astro';
import { getPrimarySection, type SecondaryTopic } from '../data/navigation';
import { getBrandBySlug } from '../data/brands';
import { getPlannedArticlesByCluster } from '../data/content-plan';
import type { UnifiedPost } from '../utils/content';

export interface Props {
  topic: SecondaryTopic;
  topicPosts: UnifiedPost[];
  relatedPosts: UnifiedPost[];
}

const { topic, topicPosts = [], relatedPosts = [] } = Astro.props;
const primarySection = getPrimarySection(topic.category);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: primarySection.name, url: primarySection.url },
  { name: topic.name, url: topic.url },
];

const topicBrands = topic.featuredBrandSlugs
  .map((s) => getBrandBySlug(s))
  .filter(Boolean);

const topicFaq = topic.clusters.flatMap((c) =>
  c.geoQuestions.map((q) => ({
    q,
    a: `${c.summary} 具体参数与实测数据请参考本专题下的核心评测文章《${topicPosts[0]?.title || topic.seoTitle}》及关联品牌档案。`,
  }))
);

// Determine layout variation based on topic index so secondary pages have varied card arrangements
const isHorizontalLayout = topic.slug.includes('recommend') || topic.slug.includes('comparison') || topic.slug.includes('tutorial');
---

<BaseLayout
  title={topic.seoTitle}
  description={topic.description}
  breadcrumbs={breadcrumbs}
  faq={topicFaq}
  schemaType="ItemList"
  itemListElements={topicPosts.map((p) => ({
    name: p.title,
    url: p.url,
    description: p.description,
  }))}
>
  <!-- Secondary Topic Hero -->
  <section class="bg-[#F7F9FC] border-b border-[#E5EAF1] py-9 sm:py-12">
    <div class="editorial-container">
      <Breadcrumb items={breadcrumbs} />
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="badge-category">{primarySection.name} · 二级专题</span>
            <span class="badge-neutral">主关键词: {topic.primaryKeyword}</span>
            <span class="badge-neutral">搜索意图: {topic.searchIntent}</span>
          </div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#172033] leading-tight">
            {topic.name}：{topic.seoTitle.split('：')[1] || topic.seoTitle}
          </h1>
          <p class="mt-3 text-base text-[#64748B] leading-relaxed">
            {topic.intro}
          </p>
        </div>

        <!-- Key Takeaways Card -->
        <div class="lg:col-span-4 card-surface p-5 bg-white">
          <h2 class="text-sm font-bold text-[#172033] mb-2.5 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#2563EB]"></span>
            <span>本专题核心结论速览</span>
          </h2>
          <ul class="space-y-2 text-xs text-[#172033]/85 leading-relaxed">
            {topic.keyTakeaways.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-[#2563EB] font-bold">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="editorial-container py-10 space-y-12">
    <!-- Tertiary Clusters Matrix (2+ Clusters per Topic) -->
    <section aria-labelledby="clusters-heading">
      <div class="mb-6">
        <h2 id="clusters-heading" class="text-xl sm:text-2xl font-bold text-[#172033]">
          「{topic.name}」三级文章集群架构 (Pillar-Cluster Matrix)
        </h2>
        <p class="text-sm text-[#64748B] mt-1">
          围绕用户真实搜索问题拆解三级集群，连接核心支柱长文、延伸教程与品牌实测
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {topic.clusters.map((cluster, idx) => {
          const plannedItems = getPlannedArticlesByCluster(cluster.id);
          const corePost = topicPosts.find((p) => p.slug === cluster.coreArticleSlug) || topicPosts[0];
          return (
            <div class="card-surface p-6 flex flex-col justify-between bg-gradient-to-b from-white to-[#F7F9FC]/60">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#EFF6FF] text-[#2563EB]">
                    三级集群 0{idx + 1} · {cluster.targetKeyword}
                  </span>
                  <span class="text-xs font-mono text-[#64748B]">{cluster.searchIntent}</span>
                </div>

                <h3 class="text-lg font-bold text-[#172033]">{cluster.name}</h3>
                <p class="mt-1.5 text-xs font-medium text-[#2563EB] bg-[#EFF6FF]/50 px-3 py-1.5 rounded-lg">
                  核心搜索问题：{cluster.userQuestion}
                </p>
                <p class="mt-2.5 text-sm text-[#64748B] leading-relaxed">
                  {cluster.summary}
                </p>

                <!-- Core Published Article Entry -->
                {corePost && (
                  <div class="mt-4 p-3.5 rounded-xl bg-white border border-blue-200 shadow-sm">
                    <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">
                      ✓ 已发布核心长文
                    </span>
                    <a
                      href={corePost.url}
                      class="mt-1.5 block text-sm font-bold text-[#172033] hover:text-[#2563EB] transition-colors"
                    >
                      {corePost.title} →
                    </a>
                    <p class="mt-1 text-xs text-[#64748B] line-clamp-2">{corePost.excerpt}</p>
                  </div>
                )}

                <!-- Cluster Planned Topic Queue -->
                {plannedItems.length > 0 && (
                  <div class="mt-4">
                    <span class="text-xs font-semibold text-[#172033] block mb-2">
                      集群覆盖细分选题矩阵（共规划 {plannedItems.length} 篇）：
                    </span>
                    <ul class="space-y-1.5 text-xs">
                      {plannedItems.slice(0, 5).map((item) => (
                        <li class="flex items-center justify-between gap-2 px-2.5 py-1.5 rounded bg-white border border-[#E5EAF1]">
                          {item.status === 'Published' ? (
                            <a href={item.url} class="font-semibold text-[#2563EB] hover:underline truncate">
                              ● {item.title}
                            </a>
                          ) : (
                            <span class="text-[#64748B] truncate">○ {item.title}</span>
                          )}
                          <span
                            class:list={[
                              'text-[10px] px-1.5 py-0.5 rounded shrink-0',
                              item.status === 'Published'
                                ? 'bg-emerald-50 text-emerald-700 font-semibold'
                                : 'bg-slate-100 text-slate-500',
                            ]}
                          >
                            {item.status === 'Published' ? '已发布' : `规划 ${item.priority}`}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>

              <div class="mt-4 pt-3 border-t border-[#E5EAF1] flex flex-wrap items-center justify-between gap-2 text-xs">
                <div class="flex flex-wrap gap-1">
                  {cluster.relatedBrands.slice(0, 4).map((bSlug) => {
                    const b = getBrandBySlug(bSlug);
                    return b ? (
                      <a
                        href={`/brands/${b.slug}/`}
                        class="px-2 py-0.5 rounded bg-[#F7F9FC] border border-[#E5EAF1] text-[#172033] hover:text-[#2563EB]"
                      >
                        {b.name}
                      </a>
                    ) : null;
                  })}
                </div>
                {corePost && (
                  <a href={corePost.url} class="font-semibold text-[#2563EB] hover:underline">
                    阅读集群主文 →
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Published Articles in this Topic -->
    <section aria-labelledby="topic-posts-heading">
      <div class="flex items-center justify-between mb-5">
        <h2 id="topic-posts-heading" class="text-xl sm:text-2xl font-bold text-[#172033]">
          「{topic.name}」精选与最新文章
        </h2>
        <a href={primarySection.url} class="text-sm font-medium text-[#2563EB] hover:underline">
          返回{primarySection.name}主页 →
        </a>
      </div>

      {isHorizontalLayout ? (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          {topicPosts.map((post) => (
            <ArticleCard post={post} horizontal={true} />
          ))}
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {topicPosts.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
      )}

      {relatedPosts.length > 0 && (
        <div class="mt-8">
          <h3 class="text-base font-bold text-[#172033] mb-3">同栏目延伸阅读推荐</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
            {relatedPosts.slice(0, 6).map((p, idx) => (
              <CompactArticleCard post={p} index={idx} />
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- Featured Brands for this Topic -->
    {topicBrands.length > 0 && (
      <section aria-labelledby="topic-brands-heading">
        <div class="flex items-center justify-between mb-5">
          <div>
            <h2 id="topic-brands-heading" class="text-xl sm:text-2xl font-bold text-[#172033]">
              「{topic.name}」关联品牌评测与对比
            </h2>
            <p class="text-sm text-[#64748B] mt-0.5">
              调用统一品牌数据源，所有价格与测速均标明核实日期
            </p>
          </div>
          <a href="/brands/" class="text-sm font-semibold text-[#2563EB] hover:underline">
            筛选全部 31 家品牌 →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {topicBrands.map((b) => b && <BrandCard brand={b} />)}
        </div>
      </section>
    )}

    <!-- GEO FAQ -->
    <FAQSection
      title={`关于「${topic.name}」的常见搜索问答 (GEO/AEO)`}
      items={topicFaq}
    />

    <!-- Conversion Module -->
    <BrandCTA
      brandSlug={topic.featuredBrandSlugs[0] || 'guangsuyun'}
      contextTitle={`${topic.name} · 综合实测推荐方案`}
    />

    <!-- Sibling Secondary Topics Navigation -->
    <section class="p-6 rounded-2xl bg-[#F7F9FC] border border-[#E5EAF1]">
      <h2 class="text-base font-bold text-[#172033] mb-3">
        探索「{primarySection.name}」下的其他二级专题
      </h2>
      <div class="flex flex-wrap gap-2">
        {primarySection.topics.map((t) => (
          <a
            href={t.url}
            class:list={[
              'px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold border transition-colors',
              t.slug === topic.slug
                ? 'bg-[#2563EB] text-white border-[#2563EB]'
                : 'bg-white text-[#172033] border-[#E5EAF1] hover:border-[#2563EB] hover:text-[#2563EB]',
            ]}
          >
            {t.name}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
