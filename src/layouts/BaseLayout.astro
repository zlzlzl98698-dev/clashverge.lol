---
import '../styles/global.css';
import SEOHead, { type BreadcrumbItem, type FAQItem } from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  pubDate?: string;
  updatedDate?: string;
  author?: string;
  breadcrumbs?: BreadcrumbItem[];
  faq?: FAQItem[];
  schemaType?: 'WebPage' | 'Article' | 'BlogPosting' | 'ItemList' | 'SoftwareApplication';
  itemListElements?: { name: string; url: string; description?: string }[];
  softwareInfo?: {
    name: string;
    operatingSystem: string;
    applicationCategory?: string;
    price?: string;
  };
  reviewInfo?: {
    itemName: string;
    ratingValue: string;
    bestRating?: string;
    reviewBody: string;
  };
  noindex?: boolean;
  pagefindIgnore?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage,
  pubDate,
  updatedDate,
  author,
  breadcrumbs = [],
  faq = [],
  schemaType = 'WebPage',
  itemListElements = [],
  softwareInfo,
  reviewInfo,
  noindex = false,
  pagefindIgnore = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
      ogImage={ogImage}
      pubDate={pubDate}
      updatedDate={updatedDate}
      author={author}
      breadcrumbs={breadcrumbs}
      faq={faq}
      schemaType={schemaType}
      itemListElements={itemListElements}
      softwareInfo={softwareInfo}
      reviewInfo={reviewInfo}
      noindex={noindex}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-[#172033]">
    <Header />
    <main
      id="main-content"
      class="flex-1"
      data-pagefind-body={pagefindIgnore ? undefined : ''}
      data-pagefind-ignore={pagefindIgnore ? 'all' : undefined}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
