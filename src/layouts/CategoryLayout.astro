---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TopicCard from '../components/cards/TopicCard.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import FeaturedArticleCard from '../components/cards/FeaturedArticleCard.astro';
import CompactArticleCard from '../components/cards/CompactArticleCard.astro';
import BrandCard from '../components/cards/BrandCard.astro';
import type { PrimaryNavSection } from '../data/navigation';
import type { UnifiedPost } from '../utils/content';
import { AIRPORT_BRANDS } from '../data/brands';

export interface Props {
  section: PrimaryNavSection;
  posts: UnifiedPost[];
  faq?: { q: string; a: string }[];
}

const { section, posts = [], faq = [] } = Astro.props;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: section.name, url: section.url },
];

const featuredPost = posts.find((p) => p.pillar || p.featured) || posts[0];
const restPosts = posts.filter((p) => p.slug !== featuredPost?.slug);
const recommendedBrands = AIRPORT_BRANDS.slice(0, 6);
---

<BaseLayout
  title={section.seoTitle}
  description={section.description}
  breadcrumbs={breadcrumbs}
  faq={faq}
  schemaType="ItemList"
  itemListElements={section.topics.map((t) => ({
    name: t.name,
    url: t.url,
    description: t.description,
  }))}
>
  <!-- Category Hero -->
  <section class="bg-[#F7F9FC] border-b border-[#E5EAF1] py-10 sm:py-14">
    <div class="editorial-container">
      <Breadcrumb items={breadcrumbs} />
      <div class="max-w-4xl">
        <span class="badge-category mb-3">{section.heroBadge}</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#172033]">
          {section.name}专题总览与内容矩阵
        </h1>
        <p class="mt-3 text-base sm:text-lg text-[#64748B] leading-relaxed">
          {section.intro}
        </p>
      </div>

      <!-- Quick Subtopic Pills -->
      <div class="mt-6 flex flex-wrap gap-2">
        {section.topics.map((t) => (
          <a
            href={t.url}
            class="px-3.5 py-2 rounded-xl bg-white border border-[#E5EAF1] text-sm font-semibold text-[#172033] hover:border-[#2563EB] hover:text-[#2563EB] shadow-sm transition-all"
          >
            {t.name} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="editorial-container py-10 space-y-14">
    <!-- Custom Slot for Category-Specific Differentiated Module -->
    <slot name="category-lead" />

    <!-- 7 Secondary Topics Grid (Differentiated layout per category key) -->
    <section aria-labelledby="subtopics-heading">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
        <div>
          <h2 id="subtopics-heading" class="text-2xl font-bold text-[#172033]">
            「{section.name}」下属 7 大二级专题与 14 个三级文章集群
          </h2>
          <p class="text-sm text-[#64748B] mt-1">
            每个二级专题均拥有独立 URL 与专属内容集群，拒绝锚点拼凑
          </p>
        </div>
      </div>

      <div
        class:list={[
          'grid gap-5',
          section.key === 'airport'
            ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'
            : section.key === 'vpn'
              ? 'grid-cols-1 md:grid-cols-2'
              : section.key === 'clash'
                ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4'
                : 'grid-cols-1 md:grid-cols-3',
        ]}
      >
        {section.topics.map((topic) => (
          <TopicCard topic={topic} />
        ))}
      </div>
    </section>

    <!-- Featured Pillar Article + Category Articles -->
    {featuredPost && (
      <section aria-labelledby="cat-articles-heading" class="space-y-6">
        <div class="flex items-center justify-between">
          <h2 id="cat-articles-heading" class="text-2xl font-bold text-[#172033]">
            「{section.name}」专栏核心原创文章
          </h2>
          <a href="/articles/" class="text-sm font-semibold text-[#2563EB] hover:underline">
            查看全部原创文章 →
          </a>
        </div>

        <FeaturedArticleCard post={featuredPost} />

        {restPosts.length > 0 && (
          <div
            class:list={[
              'grid gap-5 mt-6',
              section.key === 'clash' || section.key === 'vpn'
                ? 'grid-cols-1 lg:grid-cols-2'
                : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
            ]}
          >
            {restPosts.map((post, i) =>
              section.key === 'resources' && i >= 3 ? (
                <CompactArticleCard post={post} index={i} />
              ) : (
                <ArticleCard
                  post={post}
                  horizontal={section.key === 'vpn' && i < 2}
                />
              )
            )}
          </div>
        )}
      </section>
    )}

    <!-- Category Brand Recommendations -->
    {section.key === 'airport' || section.key === 'vpn' ? (
      <section aria-labelledby="cat-brands-heading">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 id="cat-brands-heading" class="text-2xl font-bold text-[#172033]">
              关联专线品牌数据库精选
            </h2>
            <p class="text-sm text-[#64748B] mt-1">
              基于 2026-10-19 实测与品牌资料核实，点击可查看完整套餐与测速图
            </p>
          </div>
          <a href="/brands/" class="text-sm font-semibold text-[#2563EB] hover:underline">
            进入 31 家品牌数据库 →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {recommendedBrands.map((b) => (
            <BrandCard brand={b} compact={true} />
          ))}
        </div>
      </section>
    ) : null}

    <slot />
  </div>
</BaseLayout>
